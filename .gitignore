# Python
__pycache__/
*.py[cod]

# Ruff (see ruff.toml)
.ruff_cache/

# Quarto build cache
.quarto/
*_files/

# Rendered revealjs decks. The .qmd source and the .pptx are committed; the
# HTML is not. GitHub will not render an HTML file when you click it, so it
# would serve nobody, and each self-contained deck is around 6 MB.
# Regenerate any time with: scripts/render_slides.sh
*.html
# ...except the GitHub Pages site, which must be committed for Pages to serve it.
!docs/*.html
# The spine is published to the site so qmib.REMOTE works outside a clone.
!docs/data/
!docs/data/*.parquet

# The LIVE midterm — the paper actually sat, with different numbers from the public
# sample in assessments/midterm/. NEVER commit this directory: the repository is public.
assessments/midterm/live/

# Instructor-only ground truth written by scripts/build_spine/make_fixtures.py
scripts/build_spine/.truth/


# Per-machine editor/agent session settings
.claude/settings.local.json

# macOS
.DS_Store

# Teaching datasets fetched by scripts/fetch_teaching_data.py. They belong to
# their original publishers, so the repository carries the fetch script rather
# than the data. The synthetic spine in data/spine/ is ours and IS committed.
/data/loans.parquet
/data/redwines.parquet
/data/hsbdemo.parquet
/data/ologit.parquet

# Local Python environment (built from requirements.txt, never committed)
.venv/
venv/

# Agent scratch: renders, QA artefacts and inspection dumps (~340 MB, no sources).
.codex-work/

# Microsoft Office lock files, created while a document is open.
~$*

# Stray R graphics device output.
Rplots.pdf
