        "---\n",
        "title: \"Regularisation: Ridge, Lasso, and the Elastic Net\"\n",
        "subtitle: \"Session 05 · Lecture, first half\"\n",
        "author: \"Thierry Warin\"\n",
        "institute: \"HEC Montréal\"\n",
        "date: last-modified\n",
